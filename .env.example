# Copy to .env (gitignored). Claude Code is denied read access to .env.

# Claude API key for the APP (case-draft worker, agent eval, mapping assistant).
# Deliberately NOT named ANTHROPIC_API_KEY: if that variable is in the shell where Claude Code runs,
# Claude Code bills that key instead of your subscription.
AML_ANTHROPIC_API_KEY=

# Local services
POSTGRES_USER=aml
POSTGRES_PASSWORD=aml-local-only
POSTGRES_DB=aml
KAFKA_BOOTSTRAP=localhost:19092
SCHEMA_REGISTRY_URL=http://localhost:18081
MLFLOW_TRACKING_URI=http://localhost:5000

# AWS (only for cloud milestones; credentials live in ~/.aws, never here)
AWS_PROFILE=stream-aml
AWS_REGION=us-east-1
